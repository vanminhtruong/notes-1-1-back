# Environment variables example

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
SQLITE_STORAGE=data/app.sqlite
# Optional: absolute directory OUTSIDE the backend repository.
# Windows default: E:/PlantHub-backups/backend
SQLITE_BACKUP_DIR=E:/PlantHub-backups/backend
SQLITE_BACKUP_KEEP=14

# Logging
SEQUELIZE_LOG=false

# JWT Configuration
JWT_SECRET=f8e7c3b9d2a6f4e1c8b7a5f3e9d2c6b4a8f7e3d9c5b2a7f4e1c8b6d3a9f5e2c7b4a8f6e3d1c9b5a7f4e2c8b6d3a9f5e1c7b4a8f6e3d2c9b5a7f4e1c8b6d3a9f5e2c7b4a8f6e3d1c9b5a7f4e2c8b6d3a9f5e1
JWT_EXPIRES_IN=7d

# Frontend / CORS (Comma-separated allowlist in production)
# In development, CORS is permissive by default; this is mainly for production.
# Examples:
# FRONT_ORIGIN=http://localhost:5173
# FRONT_ORIGIN=http://localhost:5173,http://192.168.1.10:5173,https://your-domain.com
FRONT_ORIGIN=http://localhost:5173

# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=330597757388-cdngesnvlcn7uiev2ptar27bu1gco9bt.apps.googleusercontent.com

# SMTP (Email Sending)
# Required for Forgot Password emails. Missing configuration returns an error.
# No OTP or email content is printed to the console.
# Brevo: use the SMTP login and SMTP key from Settings > SMTP & API.
# SMTP_FROM must be a sender verified in Brevo; it is not the SMTP login.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PlantHub <verified-sender@example.com>"

# SMS (Twilio) - optional
# If not configured, the app will log SMS to console in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890
